# ==========================================
# JOBCONNECT BACKEND - PRODUCTION ENVIRONMENT
# ==========================================

# Port d'écoute du serveur HTTP (défini automatiquement par Render / Heroku / Cloud Run)
PORT=10000
NODE_ENV=production

# Base de données PostgreSQL (obtenue sur Render Postgres, Supabase, Neon ou AWS RDS)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL=postgresql://jobconnect_admin:votre_mot_de_passe_fort@dpg-xxxx.frankfurt-postgres.render.com/jobconnect?sslmode=require

# Clé secrète JWT cryptographique (minimum 32 caractères aléatoires obligatoires)
# Commande pour générer: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generer_une_chaine_aleatoire_tres_longue_et_securisee_min_32_chars

# URL publique du Frontend Web pour autoriser les échanges CORS et Socket.io
FRONTEND_URL=https://jobconnect-web.vercel.app

# Clés d'intégration Stripe (Paiements réels)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_votre_cle_stripe_secrete_live
STRIPE_WEBHOOK_SECRET=whsec_votre_cle_secrete_de_webhook_stripe

# Clé API Google Gemini (IA générative d'annonces et support chatbot)
GEMINI_API_KEY=AIzaSy_votre_cle_gemini_api
